<div class="px-6 py-8">
  <% base_params = {
       type: @type,
       catalog_id: @catalog_id,
       provider: params[:provider],
       reference: params[:reference],
       genre: params[:genre],
       title: params[:title]
     } %>

  <div class="flex items-center justify-between gap-4 mb-6">
    <h1 class="text-3xl font-bold text-white"><%= @title %></h1>
    <div class="flex items-center gap-2">
      <% if @page > 1 %>
        <%= link_to "Previous", catalog_path(base_params.merge(page: @page - 1, size: @size)), class: "btn-secondary text-sm", data: { page_loader: "link" } %>
      <% end %>
      <span class="text-sm text-sv-text-muted">Page <%= @page %></span>
      <% if @has_more %>
        <%= link_to "Next", catalog_path(base_params.merge(page: @page + 1, size: @next_size)), class: "btn-secondary text-sm", data: { page_loader: "link" } %>
      <% end %>
    </div>
  </div>

  <% if @error.present? %>
    <div class="p-4 bg-sv-surface rounded-lg border border-sv-border text-center">
      <p class="text-sv-warning"><%= @error %></p>
    </div>
  <% elsif @items.empty? %>
    <div class="p-4 bg-sv-surface rounded-lg border border-sv-border text-center">
      <p class="text-sv-text-muted">No items on this page.</p>
      <%= link_to "Back to start", catalog_path(base_params.merge(page: 1, size: CatalogController::DEFAULT_PAGE_SIZE)), class: "text-sm text-sv-accent hover:underline mt-2 inline-block" %>
    </div>
  <% else %>
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-4">
      <% @items.each do |item| %>
        <%= render "shared/poster_card",
          item: item,
          link_path: content_path(type: item[:type].presence || @type, imdb_id: item[:imdb_id]) %>
      <% end %>
    </div>

    <div class="flex items-center justify-center gap-3 mt-8">
      <% if @page > 1 %>
        <%= link_to "Previous", catalog_path(base_params.merge(page: @page - 1, size: @size)), class: "btn-secondary text-sm", data: { page_loader: "link" } %>
      <% end %>
      <% if @has_more %>
        <%= link_to "Next", catalog_path(base_params.merge(page: @page + 1, size: @next_size)), class: "btn-secondary text-sm", data: { page_loader: "link" } %>
      <% end %>
    </div>
  <% end %>
</div>
